{
  "name": "krumbz-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-vendor.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "images:readme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/images-readme.mts",
    "todo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/todo-report.mjs",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand-icons.mjs",
    "budgets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-budgets.mjs",
    "lighthouse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lighthouse.mjs",
    "test:e2e": "playwright test",
    "build:3d": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-3d.mjs",
    "optimize:3d": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/optimize-3d.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mts",
    "db:seed:krumbz": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-krumbz.mts",
    "test:isolation": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/isolation/*.test.mts\"",
    "admin:create": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-superadmin.mts",
    "db:seed:demo": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-demo.mts",
    "vendor:create": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-vendor.mts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "detect-gpu": "^5.0.70",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "chrome-launcher": "^1.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
