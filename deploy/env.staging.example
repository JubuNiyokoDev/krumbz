# Rundinova Studio — préproduction : modèle de /opt/rundinova-studio-staging/.env
# Copier, remplir sur le VPS, puis : chmod 600 .env. NE JAMAIS committer le fichier rempli.
# Valeurs TOUJOURS différentes de la production (autre base, autres secrets).
#
# Imposés par compose.staging.yml : NODE_ENV, PORT, HOSTNAME, NODE_OPTIONS, DATABASE_URL,
# TRUST_FORWARDED_HOST=1, UPLOADS_DIR, CERT_REQUESTS_DIR, CERT_STATUS_DIR, HEALTH_STATUS_FILE.

POSTGRES_PASSWORD=change-me-staging-openssl-rand-hex-24

# Même racine : l'app reconnaît le préfixe staging- (staging-krumbz.rundinova.com, staging-admin…).
PLATFORM_ROOT_DOMAIN=rundinova.com
NEXT_PUBLIC_SITE_URL=https://staging-krumbz.rundinova.com

SESSION_SECRET=change-me-staging-openssl-rand-base64-48
DATABASE_POOL_MAX=3
