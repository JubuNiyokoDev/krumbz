# Rundinova Studio — production : modèle de /opt/rundinova-studio/.env
# Copier, remplir sur le VPS, puis : chmod 600 .env (propriétaire : l'utilisateur de déploiement).
# NE JAMAIS committer le fichier rempli. Valeurs ci-dessous = espaces réservés.
#
# Imposés par compose.production.yml (inutile de les mettre ici) : NODE_ENV, PORT, HOSTNAME,
# NODE_OPTIONS, DATABASE_URL (construit à partir de POSTGRES_PASSWORD), TRUST_FORWARDED_HOST=1,
# UPLOADS_DIR, CERT_REQUESTS_DIR, CERT_STATUS_DIR, HEALTH_STATUS_FILE.

# Mot de passe de la base dédiée (conteneur rundinova-studio-db). Hexadécimal conseillé
# (aucun caractère à échapper dans l'URL) : openssl rand -hex 24
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# Domaine racine : <vendeur>.ROOT, isoko.ROOT, admin.ROOT, espace.ROOT.
# ROOT et www.ROOT = site officiel, jamais servis par la plateforme.
PLATFORM_ROOT_DOMAIN=rundinova.com

# URL publique de repli (Krumbz : URLs canoniques, sitemap). Aussi passée au build (CI).
NEXT_PUBLIC_SITE_URL=https://krumbz.rundinova.com

# Signature des sessions (32 octets aléatoires au moins) : openssl rand -base64 48
SESSION_SECRET=change-me-openssl-rand-base64-48

# Taille du pool PostgreSQL par processus Node (max_connections de la base = 30).
DATABASE_POOL_MAX=5

# Optionnel : jeton exigé par GET /api/health/shops (si l'app l'implémente) ; health.sh le lit ici.
# HEALTH_TOKEN=change-me
