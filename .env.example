# Copy to .env.local (git-ignored) for local development.

# PostgreSQL of Rundinova Studio (dedicated container, never the VPS shared PostgreSQL).
# Local throwaway database:
#   docker run -d --name rs-dev-db -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=rundinova_studio \
#     -p 127.0.0.1:55432:5432 --memory 256m postgres:16-alpine
#   npm run db:migrate && npm run db:seed:krumbz
DATABASE_URL=postgres://postgres:dev@127.0.0.1:55432/rundinova_studio
# Pool size per Node process (default 5).
# DATABASE_POOL_MAX=5

# Root domain of the platform: <vendor>.ROOT, isoko.ROOT (marketing), admin.ROOT, espace.ROOT,
# staging-<x>.ROOT for pre-production. ROOT itself and www.ROOT are the company site: never served.
PLATFORM_ROOT_DOMAIN=rundinova.com
# Set to 1 only behind the VPS nginx (TLS termination), which overwrites X-Forwarded-Host.
# Otherwise the Host header is used.
# TRUST_FORWARDED_HOST=1

# Public URL of the Krumbz storefront (canonical URLs, sitemap, Open Graph).
# NEXT_PUBLIC_SITE_URL=https://krumbz.rundinova.com

# TLS certificates per tenant host (file-based handshake with the host, src/lib/tenant/certs.ts):
# the app writes <host> into CERT_REQUESTS_DIR, the host-side job writes <host>.json into CERT_STATUS_DIR.
# CERT_REQUESTS_DIR=/data/cert-requests
# CERT_STATUS_DIR=/data/cert-status

# Uploaded images (sharp → WebP/AVIF), served by /uploads/… (default ./.data/uploads in dev).
# UPLOADS_DIR=/data/uploads
# Secret used to hash client addresses for login rate limiting (random, 32+ chars, server only).
# SESSION_SECRET=
# Health status written by scripts/ops/health.sh, shown in the super-admin « Santé » page.
# HEALTH_STATUS_FILE=/data/status/health.json
